{
  "name": "@ecommerce/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run build && concurrently --kill-others --names compiler,server \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "prisma generate && tsc",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bullmq": "^5.0.0",
    "cloudinary": "^2.0.0",
    "dotenv": "^17.0.0",
    "ioredis": "^5.0.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^7.0.0",
    "typescript": "~5.9.3"
  }
}
