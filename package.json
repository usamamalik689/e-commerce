{
  "name": "ecommerce",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w @ecommerce/web",
    "dev:api": "npm run dev -w @ecommerce/api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint -w @ecommerce/web",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate -w @ecommerce/api",
    "db:validate": "npm run db:validate -w @ecommerce/api",
    "db:migrate": "npm run db:migrate -w @ecommerce/api --"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
